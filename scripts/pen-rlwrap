#!/bin/bash
export TTY

while [ $# -gt 0 ]; do opt="$1"; case "$opt" in
    "") { shift; }; ;;
    -get-rl-histfile) {
        get_rl_histfile=y
        shift
    }
    ;;

    *) break;
esac; done

# Hmm.. I think I do actually want to be using rlwrap even inside comint, typically, so, for example, I'm recording the REPL history.

# j:comint-quick makes an nsfa with INSIDE_COMINT=y

# I need a way to "unreadlinify" any command passed to comint
# TODO Make an "unrl" (unreadline) command to wrap around a readline repl to un-readlinify it for use in comint
if test "$NO_RL" = y || printf -- "%s\n" "$INSIDE_EMACS" | grep -q -P 'comint$' || test "$INSIDE_COMINT" = y; then
    # skip rlwrap
    "$@"
    exit "$?"
fi

# /usr/bin/rlwrap "$@"

if test "$get_rl_histfile" = "y"; then
    :
else
    ppid="$(ps -o comm= $PPID)"
    ( hs "$(basename "$0")" "$@" "#" "<==" "$ppid" 0</dev/null ) &>/dev/null
fi

# Also, use this to determine if we're inside rlwrap
export RLWRAP_EDITOR="$EDITOR"

# Frustratingly, I can't use getopt here because it fails when the
# command has options not listed here.

# OPTS="$(getopt -o H:f: -- "$@")"
# 
# if [ $? != 0 ] ; then
#     cmd1 "$@"
#     echo "Failed parsing options." >&2 ; exit 1 ;
# fi
# 
# eval set -- "$OPTS"
# 
# while true; do
#   case "$1" in
#     -H ) hf="$2"; shift 2 ;;
#     # -f can actually be given multiple times.
#     -f ) cf="$2"; shift 2 ;;
#     -- ) shift; break ;;
#     * ) break ;;
#   esac
# done

while [ $# -gt 0 ]; do opt="$1"; case "$opt" in
    "") { shift; }; ;;
    -H) {
        hf="$2"
        shift
        shift
    }
    ;;

    -c) {
        cf="$2"
        shift
        shift
    }
    ;;

    *) break;
esac; done

# last_arg="${@: -1}"
# hfn="$(printf -- "%s" "$last_arg" | slugify)"

hfn="$(cmd "$@" | hash-trim 100 | slugify)"

mkdir -p $NOTES/programs/rlwrap/completions
mkdir -p $NOTES/programs/rlwrap/history

: "${cf:="$NOTES/programs/rlwrap/completions/${hfn}"}"
: "${hf:="$NOTES/programs/rlwrap/history/${hfn}"}"

touch "$hf"
touch "$cf"

if test "$get_rl_histfile" = "y"; then
    echo "$hf"
else
    # Specifying `--break-chars ""` means that words are split by whitespace only
    # /root/.emacs.d/host/pen.el/scripts/ed
    
    # cmd1 /usr/bin/rlwrap -a -H "$hf" -f "$cf" "$@" 1>&2
    /usr/bin/rlwrap --break-chars "" -n -a -s 1000 -H "$hf" -f "$cf" "$@"
fi
