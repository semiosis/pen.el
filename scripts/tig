#!/bin/bash
export TTY

. $SCRIPTS/lib/hs

test -f "/usr/bin/tig" || agi "tig" &>/dev/null

while [ $# -gt 0 ]; do opt="$1"; case "$opt" in
    "") { shift; }; ;;
    -h) {
        mode=help
        shift
    }
    ;;

    *) break;
esac; done

is_tty() { [ -t 1 ] && ! test "$TERM" = "dumb"; }
is_stdout_pipe() {
    # If stout is a pipe
    [[ -p /dev/stdout ]]
}

runhelp() {
    if is_tty && ! is_stdout_pipe; then
        bare_repo_for_tig_dp="$TMPDIR/tig"
        mkdir -p "$bare_repo_for_tig_dp"
        cd "$bare_repo_for_tig_dp"
        test -d ".git" || {
            git init
            touch README.org
            git add README.org
            git commit -m "first"
        } &>/dev/null
        x -sh tig -e first -s vh -i
    else
        /usr/bin/tig -h "$@"
        exit "$?"
    fi
}

case "$mode" in
    help) {
        runhelp
        exit "$?"
    }
    ;;

    *)
esac

# j:term-exec-around-advice only partially fixed the
# eshell visual command display problem for tig.
# But adding a tmux wrapper fixed it fully.
if test -n "$INSIDE_EMACS"; then
    twr /usr/bin/tig "$@"
    # nvt -22 /usr/bin/tig "$@"
    # nvc -2 /usr/bin/tig "$@"
else
    /usr/bin/tig "$@"
fi
# /usr/bin/tig "$@"
