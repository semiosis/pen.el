#!/bin/bash
export TTY

# Total length = max-mant-len + 6

input="$(cat)"
maxmantlen="$1"
: "${maxmantlen:="15"}"

hash="$(p "$input" | pen-sha)"
hashlen=$(echo -n "$hash" | wc -m)
name="$(p "$input" | cut -c1-$((maxmantlen - hashlen)))-$hash"
strl=$(echo -n "$input" | wc -m)
if test "$strl" -lt "$maxmantlen"; then
    echo -n "$name"
else
    echo -n "$hash"
fi
