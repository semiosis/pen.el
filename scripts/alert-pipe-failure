#!/bin/bash
export TTY

# . $SCRIPTS/lib/hs

set -o pipefail

sn="$(basename -- "$0")"
oargs=("$@")
CMD="$(cmd "$@")"

while [ $# -gt 0 ]; do opt="$1"; case "$opt" in
    "") { shift; }; ;;
    -n) {
        success_test=nonempty
        shift
    }
    ;;

    -fail) {
        do_fail=y
        shift
    }
    ;;

    -ask-retry|-pause) {
        do_pause=y
        shift
    }
    ;;

    -il) {
        ignore_step_on_failure=y
        shift
    }
    ;;

    *) break;
esac; done

: "${success_test:="nonempty"}"

test "$#" -gt 0 || exit 1

input_fp="$( cat | tf txt)"
output_fp="$( cat "$input_fp" | "$@" | tf txt)"
ret="$?"

if test "$do_fail" = y || ! { test -s "$output_fp" && test -n "$(cat "$output_fp")"; }; then
    printf -- "%s\n  %s\n" "alert-pipe-failure> Failed:" "$(cmd pipe-in "$input_fp" "$@")" | tv -nw -n "<w:alert-pipe-failure!>" -d &>/dev/null

    if test "$do_pause" = "y"; then
        if nw -w -n "<alert-pipe-failure--retry?>" yn "<alert-pipe-failure--retry?>\n\n$(cmd pipe-in "$input_fp") $CMD"; then
            cat "$input_fp" | upd -ask-i "$sn" "${oargs[@]}"
            exit "$?"
        fi
    fi

    if test "$ignore_step_on_failure" = "y"; then
        cp -af "$input_fp" "$output_fp"
    fi
else
    rm -f "$input_fp"
fi
cat "$output_fp"
rm -f "$output_fp"
exit "$ret"
