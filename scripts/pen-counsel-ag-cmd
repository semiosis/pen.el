#!/bin/bash
export TTY

exec 2>/dev/null

while [ $# -gt 0 ]; do opt="$1"; case "$opt" in
    "") { shift; }; ;;
    -F|-l) {
        literally=y
        shift
    }
    ;;

    *) break;
esac; done

if test "$literally" = "y"; then
    ( rg -F -z --ignore tags --vimgrep -e "$@" . | sed 's/^\.\///'; ) &
    # ag -z --ignore tags --vimgrep -- "$@" &
    ( pen-zgrep-r -F "$@" | sed 's/^\.\///' . | sed 's/^\.\///'; ) &
    wait
    :
else
    ( rg -z --ignore tags --vimgrep -e "$@" . | sed 's/^\.\///'; ) &
    # ag -z --ignore tags --vimgrep -- "$@" &
    ( pen-zgrep-r "$@" | sed 's/^\.\///' . | sed 's/^\.\///'; ) &
    wait
    :
fi