#!/bin/bash
export TTY

# Should I by default cache curl requests?
# Perhaps.

. $SCRIPTS/lib/hs

export HTTP_PROXY
: "${http_proxy:="$HTTP_PROXY"}"
if test -n "$http_proxy"; then
    http_proxy="$http_proxy" /usr/bin/curl "$@"
    # http_proxy="$http_proxy" /usr/bin/curl -x localhost:9090 "$@"
else
    /usr/bin/curl "$@"
fi
