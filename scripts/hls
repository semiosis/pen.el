#!/bin/bash
export TTY

while [ $# -gt 0 ]; do opt="$1"; case "$opt" in
    "") { shift; }; ;;
    -ff|--force) {
        force=y
        shift
    }
    ;;

    *) break;
esac; done

# if test "$BLACK_AND_WHITE" = y || pen-rc-test -f black_and_white; then
#     # Do this especially if INSIDE_EMACS
#     export TERM=screen-2color
#     extra_commands+="|call BWSyntax()"
# fi

is_tty() { [ -t 1 ] && ! test "$TERM" = "dumb"; }

if ! test "$force" = y && ! is_tty; then
    cat
    exit "$?"
fi

# A more basic version of 'his'

colour_fg="$1"
test -n "$1" && shift

colour_bg="$1"
test -n "$1" && shift

: "${colour_fg:="reverse"}"

case "$colour_fg" in
    reverse|inverted) {
        his -i ".*"
    }
    ;;

    *)
        if test -n "$colour_bg"; then
            his -f "$colour_fg" -b "$colour_bg" ".*"
        else
            his -f "$colour_fg" ".*"
        fi
esac
