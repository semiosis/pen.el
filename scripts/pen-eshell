#!/bin/bash

. $SCRIPTS/lib/hs

# eshell takes an optional numeric argument that does nothing useful

# e -D spacemacs --runclient -e "(progn (eshell)(delete-other-windows))"

is_emacs_shell() {
    [[ $INSIDE_EMACS == *,comint ]] || [[ $INSIDE_EMACS == *,eshell ]];
}

is_tty() {
    # If stout is a tty
    [ -t 1 ] && ! test "$TERM" = "dumb" && ! is_emacs_shell;
}

if [[ $INSIDE_EMACS == *,comint ]]; then
    {
        sn="$(basename -- "$0")"
        FCMD="$(cmd-nice "$sn" "$@")"
        echo "This command was aborted:"
        echo "  $FCMD"
        echo "Start eshell:"
        echo "  mx:eshell"
    } | pen-org-template-gen org
    exit 1
fi

if [[ $INSIDE_EMACS == *,eshell ]]; then
    {
        sn="$(basename -- "$0")"
        FCMD="$(cmd-nice "$sn" "$@")"
        echo "This command was aborted:"
        echo "  $FCMD"
        echo "Start eshell:"
        echo "  mx:eshell"
    } | pen-org-template-gen org
    exit 1
fi

while [ $# -gt 0 ]; do opt="$1"; case "$opt" in
    "") { shift; }; ;;
    # -d is annoying. Sometimes -d means to background
    # sometimes -d means directory.
    # Therefore, I will use -cd
    -cd) {
        CWD="$2"
        shift
        shift
    }
    ;;

    -B) {
        to_buffer="eshell_default_output"
        shift
    }
    ;;

    -b) {
        to_buffer="$2"
        shift
        shift
    }
    ;;

    # Because it's a shell, -c should be a command
    -c|-E) {
        CMD="$1"
        mode=command
        shift
    }
    ;;

    *) break;
esac; done

if test "$1" = "y"; then
    mode=runfile
fi

: "${mode:="command"}"

: ${CWD:="$(pwd)"}; cd "$CWD"

if test -n "$to_buffer"; then
    CMD="$CMD > #<buffer $to_buffer>"
fi

if test -z "$CMD"; then
    e -e "(cd (cast-to-dirname $(cmd-nice-posix "$CWD")))(eshell)"
else
    e -e "(cd (cast-to-dirname $(cmd-nice-posix "$CWD")))(eshell-run-command $(cmd-nice-posix "$CMD"))"
fi
