#!/bin/bash
export TTY

# . $SCRIPTS/lib/hs

stdin_exists() {
    {
    ! [ -t 0 ] && \
    ! test "$NO_STDIN" = y ` # for notty. e.g. notty xt vim ` && \
    ! test "$(readlink /proc/$$/fd/0)" = /dev/null  && \
    ! test "$(readlink /proc/$$/fd/0)" = "$(readlink /proc/$$/fd/1)"
    # stdin may be redirected to the tty, but  will continue to say false (due to a bash bug)
    # So test to make sure 0 does not point to 1
    } &>/dev/null
}

if stdin_exists; then
    fp="$(cat | tf txt)"
fi

: "${fp:="$1"}"

lines="$(wc -l "$fp" | cut -d ' ' -f 1)"
words="$(wc -w "$fp" | cut -d ' ' -f 1)"
chars="$(wc -c "$fp" | cut -d ' ' -f 1)"
bytes="$(wc -c "$fp" | cut -d ' ' -f 1)"
maxlinelen="$(wc -L "$fp" | cut -d ' ' -f 1)"

echo "hwc $fp"
echo " lines: $lines"
echo " words: $words"
echo " chars: $chars"
echo " bytes: $bytes"
echo " max line length: $maxlinelen"
