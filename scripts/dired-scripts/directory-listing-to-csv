dir="$(realpath "$dir")"

maxdepth="$2"
: "${maxdepth:="1"}"


{
printf -- "\"Path\"\t\"Modification time locale\"\t\"Bytes\"\t\"Permissions\"\n"
"find" "$dir" -maxdepth "$maxdepth" "-printf" "\"%p\"\\t\"%Tc\"\\t\"%s\"\\t\"%M\"\\n"
} | pavs