#!/bin/bash
export TTY

. $SCRIPTS/lib/hs

# This had issues:
# get-interlinear I Samuel 1:8

while [ $# -gt 0 ]; do opt="$1"; case "$opt" in
    "") { shift; }; ;;
    -triarg) {
        export INT_SCRIPT_ARG_FORMAT=triarg
        shift
    }
    ;;

    -1l) {
        ONELINED=y
        shift
    }
    ;;

    -st) {
        export WITH_LINKS=y
        shift
    }
    ;;

    *) break;
esac; done

arg_s="$@"

if printf -- "%s\n" "$arg_s" | grep -q -P '[,;-]'; then
    shift "$#"

    IFS="
    "
    enumerate-bible-verse-refs "$arg_s" | awk1 | {
        while IFS="$IFS" read -r ref; do
            (
            exec 0</dev/null
            int "$ref" | awk 1
            )
        done
    } | pavs
    exit "$?"
fi

case "$INT_SCRIPT_ARG_FORMAT" in
    triarg) {
        book="$1"
        chapter="$2"
        verse="$3"
    }
    ;;

    *) {
        book="$(printf -- "%s " "$arg_s" | scrape-bible-references -b)"
        wholeref="$(printf -- "%s " "$arg_s" | scrape-bible-references -v)"
        chapversepart="$(printf -- "%s\n" "$wholeref" | sed "s~^${book} *~~")"
        chapter="$(printf -- "%s" "$chapversepart" | cut -d : -f 1)"
        verse="$(printf -- "%s" "$chapversepart" | cut -d : -f 2)"

        book="$(p "$book" | canonicalise-bible-book-title)"
    }
    ;;
esac

if test "$INSIDE_EMACS" = "y" || btest "$INSIDE_EMACS" == "*,*"; then
    NOEMACS=y
    exec 2>/dev/null
fi

# taken from e:ebible
if printf -- "%s\n" "$INSIDE_EMACS" | grep -q -P ',eshell$'; then
    export NOEMACS=y
    export BORDER=n
    # export ONELINED=y
    export DECORATED=y
    # isstdoutpipe=0
    export NO_PAGER=y
    export ORG_TEMPLATIFY=y
fi

# if test "$#" -eq 3; then
# else
#     argstr="$@"
# 
#     book="$(p "$argstr" | cut -d : -f 1 | sed 's/^\(.*\) [0-9:]\+$/\1/')"
#     chapter="$(p "$argstr" | cut -d : -f 1 | sed 's/^.* \([0-9:]\+\)$/\1/')"
#     verse="$(p "$argstr" | cut -d : -f 2)"
# 
#     test -n "$book" && test -n "$chapter" && test -n "$verse" || exit 1
# fi

test -n "$book" && test -n "$chapter" && test -n "$verse" || exit 1

ref="$(printf -- "%s\n" "$book ${chapter}:${verse}")"

book="$(printf -- "%s" "$book" |
    tr '[:upper:]' '[:lower:]' |
    tr -s " " _ |
    sed -e "s/iii_/3_/" \
        -e "s/ii_/2_/" \
        -e "s/i_/1_/" \
        -e "s/_of_john//" \
        -e "s/song_of_solomon/songs/"
    )"

url="$(printf -- "https://biblehub.com/interlinear/%s/%s-%s.htm" "$book" "$chapter" "$verse")"
link="[[$url][$ref]]"

org_templatify_maybe() {
    if test "$ORG_TEMPLATIFY" = "y"; then
        pen-org-template-gen org
    else
        cat
    fi
}

# ocif -m "ONELINED=$ONELINED" spin "biblehub-interlinear-get-word-blocks-pipeline" "$url" | pavs
{
    {
        printf -- "%s\n" "+ ${link} (Interlinear) :: " | awk 1
        ocif -m "ONELINED=$ONELINED" "biblehub-interlinear-get-word-blocks-pipeline" "$url" | awk 1 | sed 's/^/    /' | sed 's/ \+$//' | sed -z "s/\n    - / - /g"
    } | {
        if test "$WITH_LINKS" = "y"; then
            strongs-codes-relinkify
        else
            cat
        fi
    } | {
        org_templatify_maybe | ebible-pager
    }
} | pavs
