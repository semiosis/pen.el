#!/bin/bash
export TTY

while [ $# -gt 0 ]; do opt="$1"; case "$opt" in
    "") { shift; }; ;;
    --noediting|-i) {
        noreadline=y
        shift
    }
    ;;

    *) break;
esac; done

# . $SCRIPTS/lib/hs

# Run the preprocessor on any opened file
# [e:expand-bash-preprocessor]

# export BASH_ENV=$HOME/.scriptrc

# bash "$@"
# cmd bash <(echo "echo \$0") "$@"

newscript="$(0</dev/null tf sh)"

scriptname="$1"
shift
wp="$(which "$scriptname")"

if test -f "$wp"; then
    cat "$wp" | expand-bash-preprocessor > "$newscript"

    bash -c ". ${newscript}" -- "$@"
else
    if test "$noreadline" = "y"; then
        bash --rcfile "$PENELD/scripts/lib/pash" -i -- "$@"
    else
        # https://unix.stackexchange.com/a/250792
        bash --rcfile "$PENELD/scripts/lib/pash" -- "$@"
    fi
fi
