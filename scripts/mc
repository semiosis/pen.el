#!/bin/bash
export TTY

. $SCRIPTS/lib/hs

test -f "/usr/bin/mc" || agi "mc" &>/dev/null

# DONE if using nvc, make it so that when even x runs a command that uses nvc, nvc is avoided
## cd "$PENELD/scripts"; mc
# # export TERM=screen-2color
# nvc -2 /usr/bin/mc "$@"

# mc would be horrible to use for anything other than automation

while [ $# -gt 0 ]; do opt="$1"; case "$opt" in
    "") { shift; }; ;;
    -2) {
        export BLACK_AND_WHITE=y
        shift
    }
    ;;

    *) break;
esac; done

: "${TERM:="xterm-256color"}"
export TERM

case "$TERM" in
    xterm-2color|vt100) {
        TERM=screen-2color
    }
    ;;

    *)
esac

# With vt100 the arrow keys work, but menu doesn't work.
# screen-2oclor works well
# if test "$TERM" = vt100 || test -n "$INSIDE_EMACS"; then
if test "$TERM" = xterm-2color || test -n "$INSIDE_EMACS"; then
    BLACK_AND_WHITE=y
fi

if test "$BLACK_AND_WHITE" = y; then
    TERM=screen-2color
fi

# in-tty env TERM=screen-2color nvc -2 /usr/bin/mc "$@"
# in-tty env TERM=screen-2color /usr/bin/mc "$@"
in-tty /usr/bin/mc "$@"
