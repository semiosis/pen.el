#!/bin/bash
export TTY

. $SCRIPTS/lib/hs

# https://stackoverflow.com/questions/17226863/merge-multiple-stdout-stderr-into-one-stdout

while [ $# -gt 0 ]; do opt="$1"; case "$opt" in
    "") { shift; }; ;;
    -nooutlabel|-nolabel1) {
        nolabel=1
        shift
    }
    ;;

    -noerrlabel|-nolabel2) {
        nolabel=2
        shift
    }
    ;;

    -nolabel|-nolabel12) {
        nolabel=12
        shift
    }
    ;;

    *) break;
esac; done

cmd() {
    for var in "$@"
    do
        if test "$var" = '|'; then
            printf -- "%s" '| '
        else
            # trailing newlines are removed for arguments. Fix this
            printf "'%s' " "$(printf %s "$var" | sed "s/'/'\\\\''/g")";
        fi
    done | sed 's/ $//'
}

CMD="$(cmd "$@")"
: ${CMD:="$(cmd "$@")"}

set -o pipefail

# unbuffer bash -c "$CMD 2> >(sed "s/^/ERR:/")" | awk "!/^ERR:/ {gsub(/^/,\"OUT:\")}1" | pavs
unbuffer bash -c "$CMD 2> >(sed "s/^/ERR:/")" | awk "!/^ERR:/ {gsub(/^/,\"OUT:\")}1" | {
    case "$nolabel" in
        1) {
            sed 's/^OUT://'
        }
        ;;

        2) {
            sed 's/^ERR://'
        }
        ;;

        12) {
            sed 's/^\(OUT\|ERR\)://'
        }
        ;;

        *) {
            cat
        }
        ;;
    esac
} | pavs
