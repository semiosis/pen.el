#!/bin/bash
export TTY

. $SCRIPTS/lib/hs

sn="$(basename -- "$0")"

case "$sn" in
    red) {
        # restricted mode
        set -- -r "$@"
    }
    ;;

    *)
esac

# Learn to use ed:
# [[https://www.youtube.com/watch?v=S0pXQVMC770][Linux like original Unix - YouTube]]
# [[https://youtu.be/Zpdo6We-_e0][Ed Is The Standard Text Editor For Unix/Linux - YouTube]]

while [ $# -gt 0 ]; do opt="$1"; case "$opt" in
    "") { shift; }; ;;
    -nox) {
        nox=y
        shift
    }
    ;;

    -nonvt) {
        nonvt=y
        shift
    }
    ;;

    +[0-9]*) {
        GOTO_LINE="$(p "$opt" | pen-mcut -d+ -f2)"
        shift
    }
    ;;

    *) break;
esac; done

. $SCRIPTS/lib/stdin_exists

if stdin_exists; then
    input_fp="$(cat | tf txt)"
    set -- "$@" "$input_fp"
fi

# H adds error messages
# https://youtu.be/Zpdo6We-_e0?t=330

# ,g/re/p
# https://youtu.be/Zpdo6We-_e0?t=1010

: "${prompt:="${sn}> "}"

if test "$VANILLA" = "y" ; then
    builtins="$(pen-ci -otf -f -nd bash -c "info \"(ed) Commands\" | sed -n \"/^'[^ ]\\\\+'$/s/^'\\([^ ]\\\\+\\)'$/\\1/p\"")"
    in-pen /bin/ed -p "$prompt" "$@"
elif test "$nox" = "y" && test "$nonvt" = "y" ; then
    builtins="$(pen-ci -otf -f -nd bash -c "info \"(ed) Commands\" | sed -n \"/^'[^ ]\\\\+'$/s/^'\\([^ ]\\\\+\\)'$/\\1/p\"")"
    in-pen rl --break-chars "" -f "$builtins" /bin/ed -p "$prompt" "$@"
elif test "$nox" = "y"; then
    builtins="$(pen-ci -otf -f -nd bash -c "info \"(ed) Commands\" | sed -n \"/^'[^ ]\\\\+'$/s/^'\\([^ ]\\\\+\\)'$/\\1/p\"")"
    in-pen nvt -2 rl --break-chars "" -f "$builtins" /bin/ed -p "$prompt" "$@"
else
    CMD="$(cmd "$@")"
    : ${CMD:="$(cmd "$@")"}
    if test -n "$GOTO_LINE"; then
        exec <&2
        in-pen nvt -2 x -sh "ed -nox -nonvt $CMD" -e ">" -s "H" -c m -s "${GOTO_LINE}n" -c m -i
    else
        exec <&2
        in-pen nvt -2 x -sh "ed -nox -nonvt $CMD" -e ">" -s "H" -c m -i
    fi
fi
